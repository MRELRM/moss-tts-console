# ============================================================
# MOSS TTS 四合一测试台 · 环境配置示例
# 使用方法：复制本文件为 .env（同目录），填入你的 Key 后重启 node server.js
#   Windows PowerShell:  Copy-Item .env.example .env
#   macOS / Linux:       cp .env.example .env
# ============================================================

# 必填：你的 MOSS API Key（仅保存在服务端，不会下发到浏览器）
MOSS_API_KEY=你的Key

# API 基址。注意：MOSS 的域名是 api.mosi.cn（不是 moss.cn），端点在 /v1 路径下
MOSS_API_BASE_URL=https://api.mosi.cn

# 本地服务监听配置（默认 8788，与 mimo-tts-console 的 8787 错开）
PORT=8788
HOST=127.0.0.1

# 音色克隆 multipart 上传的文件字段名。
# 官方文档未明确该字段名时按行业惯例默认为 file；如实际接口报
# “缺少文件/音频样本”类错误，请按官方文档修改为实际字段名（如 audio、sample、voice_file 等）。
MOSS_CLONE_FILE_FIELD=file
